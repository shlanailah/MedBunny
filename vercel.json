{
  "services": {
    "web": {
      "root": ".",
      "framework": "vite"
    },
    "api": {
      "root": "server/",
      "framework": "hono",
      "devCommand": "npm run dev"
    }
  },
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": {
        "service": "api"
      }
    },
    {
      "source": "/health",
      "destination": {
        "service": "api"
      }
    },
    {
      "source": "/(.*)",
      "destination": {
        "service": "web"
      }
    }
  ]
}
